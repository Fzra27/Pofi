{
  "name": "pofi",
  "version": "1.4.1",
  "description": "A little focus. A little movement. Your potato companion for Linux and iPhone.",
  "main": "desktop/main.cjs",
  "author": "Pofi contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node server.cjs",
    "desktop": "electron .",
    "test": "node --test test/*.test.cjs",
    "build:linux": "electron-builder --linux deb --x64 --publish never",
    "postinstall": "install-electron",
    "relay": "node relay.cjs",
    "build:deb": "electron-builder --linux deb --x64 --publish never",
    "build:arch": "electron-builder --linux pacman --x64 --publish never",
    "build:appimage": "electron-builder --linux AppImage --x64 --publish never",
    "build:all": "electron-builder --linux deb pacman AppImage --x64 --publish never"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.pofi.desktop",
    "productName": "Pofi",
    "files": [
      "public/**/*",
      "desktop/**/*",
      "server.cjs",
      "timer.cjs",
      "package.json",
      "static.cjs",
      "remote.cjs",
      "pairing.cjs"
    ],
    "linux": {
      "target": [
        "deb",
        "pacman",
        "AppImage"
      ],
      "category": "Utility",
      "icon": "public/icon.png",
      "maintainer": "Pofi contributors <pofi@example.com>",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "pacman": {
      "artifactName": "pofi-${version}-x86_64.pkg.tar.zst",
      "compression": "zstd",
      "depends": [
        "gtk3",
        "nss",
        "libxss",
        "libxtst",
        "libnotify",
        "libsecret",
        "alsa-lib",
        "mesa",
        "libxkbcommon",
        "libdrm",
        "at-spi2-core",
        "libcups",
        "libappindicator-gtk3",
        "xdg-utils"
      ],
      "fpm": [
        "--description",
        "Pofi focus and walking companion for Linux"
      ]
    },
    "appImage": {
      "artifactName": "Pofi-${version}-x86_64.AppImage"
    }
  },
  "desktopName": "pofi.desktop",
  "engines": {
    "node": ">=24"
  }
}
